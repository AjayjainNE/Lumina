    "axes[2].set_title('LLMOps KPI Summary')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('../outputs/llmops/dashboard.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "print('LLMOps dashboard complete ✓')"
   ]
