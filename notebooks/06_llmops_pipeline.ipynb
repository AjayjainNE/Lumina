   "source": [
    "## 4. Retraining Decision Framework"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def should_retrain(detector, agent_name: str, min_alerts: int = 3) -> dict:\n",
    "    \"\"\"\n",
    "    Automated retraining decision based on drift alerts.\n",
    "    \n",
    "    Returns a decision dict with rationale — feeds into CI/CD pipeline.\n",
    "    \"\"\"\n",
    "    recent_alerts = [a for a in detector.get_alerts(since=time.time() - 86400) \n",
    "                     if a.agent_name == agent_name]\n",
    "    critical = [a for a in recent_alerts if a.severity == 'CRITICAL']\n",
    "    \n",
    "    summary = detector.summary()\n",
    "    \n",
    "    decision = {\n",
    "        'agent': agent_name,\n",
    "        'retrain': False,\n",
    "        'urgency': 'none',\n",
    "        'reason': '',\n",
    "        'recommended_action': '',\n",
    "    }\n",
    "    \n",
    "    if len(critical) >= 1:\n",
    "        decision.update({\n",
    "            'retrain': True, 'urgency': 'immediate',\n",
    "            'reason': f'{len(critical)} CRITICAL drift alert(s) — severe quality drop',\n",
    "            'recommended_action': 'Trigger PPO retraining + alert on-call team',\n",
    "        })\n",
    "    elif len(recent_alerts) >= min_alerts:\n",
    "        decision.update({\n",
    "            'retrain': True, 'urgency': 'scheduled',\n",
    "            'reason': f'{len(recent_alerts)} WARNING alert(s) in 24h — gradual drift',\n",
    "            'recommended_action': 'Schedule PPO update in next maintenance window',\n",
    "        })\n",
    "    else:\n",
    "        decision.update({\n",
    "            'reason': 'Quality metrics stable — no retraining needed',\n",
    "            'recommended_action': 'Continue monitoring',\n",
    "        })\n",
    "    \n",
    "    return decision\n",
    "\n",
    "decision = should_retrain(detector, 'summariser')\n",
    "print('\\n=== Retraining Decision ===')\n",
    "for k, v in decision.items():\n",
    "    print(f'  {k:25s}: {v}')"
   ]
  },
