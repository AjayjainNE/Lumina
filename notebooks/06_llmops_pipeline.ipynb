    "]\n",
    "tbl = axes[2].table(cellText=table_data[1:], colLabels=table_data[0],\n",
    "                     cellLoc='left', loc='center', bbox=[0, 0, 1, 1])\n",
    "tbl.auto_set_font_size(False); tbl.set_fontsize(9)\n",
    "for (r, c), cell in tbl.get_celld().items():\n",
