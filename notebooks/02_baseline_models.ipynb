   "source": [
    "# 📓 Notebook 02 — Baseline Models Benchmark\n",
    "\n",
    "**LUMINA Project** · *Individual agent performance before CGR routing*\n",
    "\n",
    "Establishes standalone baselines for each expert agent:\n",
    "- Document QA: Exact Match, F1 on DocVQA samples\n",
    "- NER: Precision, Recall, F1 per entity type\n",
    "- Summariser: ROUGE-1, ROUGE-2, ROUGE-L, BERTScore\n",
    "- LLM Judge: inter-rater agreement with human scores\n",
    "\n",
    "These baselines justify why CGR routing improves over any single agent.\n",
    "\n",
    "---"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys, os\n",
    "sys.path.insert(0, '../src')\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.gridspec as gridspec\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "os.makedirs('../outputs', exist_ok=True)\n",
    "print('Setup complete ✓')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Document QA Baseline — LayoutLMv3"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from agents.document_agent import DocumentQAAgent\n",
    "\n",
    "agent = DocumentQAAgent()\n",
    "\n",
    "# DocVQA-style test pairs (source, question, gold_answer)\n",
    "docqa_tests = [\n",
    "    ('Apple reported $394.3 billion revenue in FY2022 with net income of $99.8 billion.',\n",
    "     'What was Apple revenue in FY2022?', '394.3 billion'),\n",
    "    ('Microsoft Azure revenue increased 28% in constant currency to $91.2 billion.',\n",
    "     'By how much did Azure grow?', '28%'),\n",
    "    ('Tesla delivered 1.31 million vehicles in 2022, an increase of 40% year over year.',\n",
    "     'How many vehicles did Tesla deliver in 2022?', '1.31 million'),\n",
    "    ('Amazon Web Services revenue was $80.1 billion, representing 16% of total net sales.',\n",
    "     'What percentage of Amazon revenue was AWS?', '16%'),\n",
    "    ('Google advertising revenues were $224.5 billion compared to $209.5 billion in 2021.',\n",
    "     'What was Google ad revenue?', '224.5 billion'),\n",
    "]\n",
    "\n",
    "def token_f1(pred: str, gold: str) -> float:\n",
    "    \"\"\"Token-level F1 score (standard QA metric).\"\"\"\n",
    "    pred_toks = set(pred.lower().split())\n",
    "    gold_toks = set(gold.lower().split())\n",
    "    common = pred_toks & gold_toks\n",
    "    if not common:\n",
    "        return 0.0\n",
    "    prec = len(common) / len(pred_toks)\n",
    "    rec  = len(common) / len(gold_toks)\n",
    "    return 2 * prec * rec / (prec + rec + 1e-8)\n",
    "\n",
    "def exact_match(pred: str, gold: str) -> bool:\n",
    "    return any(g.lower() in pred.lower() for g in gold.split(','))\n",
    "\n",
    "docqa_results = []\n",
    "for source, question, gold in docqa_tests:\n",
    "    out = agent.process(source, query=question)\n",
    "    pred = out.output\n",
    "    docqa_results.append({\n",
    "        'source': source[:60] + '...', 'question': question,\n",
    "        'gold': gold, 'predicted': pred[:80],\n",
    "        'f1': token_f1(pred, gold),\n",
    "        'exact_match': exact_match(pred, gold),\n",
    "    })\n",
    "\n",
    "docqa_df = pd.DataFrame(docqa_results)\n",
    "print(f'DocQA Baseline:')\n",
    "print(f'  Mean F1:    {docqa_df[\"f1\"].mean():.3f}')\n",
    "print(f'  Exact Match: {docqa_df[\"exact_match\"].mean():.1%}')\n",
    "print()\n",
    "docqa_df[['question','gold','f1','exact_match']].round(3)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. NER Baseline — Entity F1 by Type"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from agents.ner_agent import NERAgent\n",
    "\n",
    "ner = NERAgent()\n",
    "ner._pipeline = 'fallback'\n",
    "\n",
    "ner_tests = [\n",
    "    {'text': 'Apple Inc. earned $394.3 billion. CEO Tim Cook announced the results in Q3 2022.',\n",
    "     'gold': {'ORG': ['Apple Inc.'], 'MONEY': ['$394.3 billion'], 'DATE': ['Q3 2022']}},\n",
    "    {'text': 'Microsoft Corp CEO Satya Nadella reported $198.3 billion revenue. Shares rose 4.5%.',\n",
    "     'gold': {'ORG': ['Microsoft Corp'], 'MONEY': ['$198.3 billion'], 'PERC': ['4.5%']}},\n",
    "    {'text': 'Goldman Sachs raised Apple target to $210. Shares gained 3.2% on Thursday.',\n",
    "     'gold': {'ORG': ['Goldman Sachs'], 'MONEY': ['$210'], 'PERC': ['3.2%']}},\n",
    "]\n",
    "\n",
    "ner_metrics = []\n",
    "for test in ner_tests:\n",
    "    predicted = ner.extract(test['text'])\n",
    "    for etype, gold_ents in test['gold'].items():\n",
    "        pred_ents = set(predicted.get(etype, []))\n",
    "        gold_set  = set(gold_ents)\n",
    "        tp = len(pred_ents & gold_set)\n",
    "        fp = len(pred_ents - gold_set)\n",
    "        fn = len(gold_set - pred_ents)\n",
    "        prec = tp / (tp + fp + 1e-8)\n",
    "        rec  = tp / (tp + fn + 1e-8)\n",
    "        f1   = 2*prec*rec/(prec+rec+1e-8)\n",
    "        ner_metrics.append({'entity_type': etype, 'precision': prec, 'recall': rec, 'f1': f1})\n",
    "\n",
    "ner_df = pd.DataFrame(ner_metrics).groupby('entity_type').mean().round(3)\n",
    "print('NER Baseline by Entity Type:')\n",
    "print(ner_df.to_string())\n",
    "print(f'\\nMacro-avg F1: {ner_df[\"f1\"].mean():.3f}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Summariser Baseline — ROUGE Scores"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from agents.summariser_agent import SummariserAgent\n",
    "\n",
    "summariser = SummariserAgent()\n",
    "summariser._pipeline = 'fallback'\n",
    "\n",
    "def rouge_n(pred: str, ref: str, n: int = 1) -> float:\n",
    "    \"\"\"Simplified ROUGE-N: n-gram overlap.\"\"\"\n",
    "    def ngrams(text, n):\n",
    "        words = text.lower().split()\n",
    "        return set(tuple(words[i:i+n]) for i in range(len(words)-n+1))\n",
    "    pred_ng = ngrams(pred, n)\n",
    "    ref_ng  = ngrams(ref, n)\n",
    "    if not ref_ng:\n",
    "        return 0.0\n",
    "    return len(pred_ng & ref_ng) / len(ref_ng)\n",
    "\n",
    "summary_tests = [\n",
    "    {'source': 'Apple Inc. reported total net revenues of $394.3 billion for fiscal year 2022. Net income was $99.8 billion. iPhone revenue increased 6.6% to $205.5 billion. Services revenue hit a record $78.1 billion.',\n",
    "     'reference': 'Apple revenue was $394.3 billion in FY2022. Net income $99.8 billion. iPhone grew 6.6%.'},\n",
    "    {'source': 'Microsoft reported revenue of $198.3 billion for fiscal year 2022. Azure cloud revenue grew 28%. Commercial cloud revenue was $91.2 billion, up 32%. Operating income was $83.4 billion.',\n",
    "     'reference': 'Microsoft FY2022 revenue $198.3 billion. Azure +28%. Commercial cloud $91.2 billion.'},\n",
    "    {'source': 'Alphabet Inc. reported revenues of $282.8 billion in 2022. Google advertising revenues were $224.5 billion. Google Cloud revenue was $26.3 billion. YouTube advertising generated $29.2 billion.',\n",
    "     'reference': 'Alphabet 2022 revenue $282.8 billion. Google ads $224.5 billion. Cloud $26.3 billion.'},\n",
    "]\n",
    "\n",
    "rouge_results = []\n",
    "for test in summary_tests:\n",
    "    out = summariser.process(test['source'])\n",
    "    pred = out.output\n",
    "    rouge_results.append({\n",
    "        'rouge1': rouge_n(pred, test['reference'], 1),\n",
    "        'rouge2': rouge_n(pred, test['reference'], 2),\n",
    "        'compression': out.metadata.get('compression_ratio', 1.0),\n",
    "    })\n",
    "\n",
    "rouge_df = pd.DataFrame(rouge_results)\n",
    "print('Summariser Baseline:')\n",
    "print(f'  ROUGE-1:     {rouge_df[\"rouge1\"].mean():.3f}')\n",
    "print(f'  ROUGE-2:     {rouge_df[\"rouge2\"].mean():.3f}')\n",
    "print(f'  Compression: {rouge_df[\"compression\"].mean():.1f}x')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Consolidated Baseline Dashboard"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, axes = plt.subplots(1, 3, figsize=(16, 6))\n",
    "fig.suptitle('LUMINA — Expert Agent Baseline Performance', fontweight='bold', fontsize=13)\n",
    "\n",
    "# DocQA\n",
    "ax1 = axes[0]\n",
    "metrics = ['Mean F1', 'Exact Match']\n",
    "vals = [docqa_df['f1'].mean(), docqa_df['exact_match'].mean()]\n",
    "bars = ax1.bar(metrics, vals, color=['#7F77DD','#534AB7'], alpha=0.85, width=0.4)\n",
    "ax1.set_ylim(0, 1.1); ax1.set_title('Document QA (LayoutLMv3)')\n",
    "ax1.set_ylabel('Score'); ax1.grid(axis='y', alpha=0.3)\n",
    "for bar, v in zip(bars, vals):\n",
    "    ax1.text(bar.get_x()+bar.get_width()/2, v+0.01, f'{v:.3f}', ha='center', fontsize=10, fontweight='bold')\n",
    "\n",
    "# NER per entity type\n",
    "ax2 = axes[1]\n",
    "ner_df_reset = ner_df.reset_index()\n",
    "x = range(len(ner_df_reset))\n",
    "w = 0.25\n",
    "ax2.bar([xi-w for xi in x], ner_df_reset['precision'], w, label='Precision', color='#7F77DD', alpha=0.85)\n",
    "ax2.bar([xi    for xi in x], ner_df_reset['recall'],    w, label='Recall',    color='#1D9E75', alpha=0.85)\n",
    "ax2.bar([xi+w  for xi in x], ner_df_reset['f1'],        w, label='F1',        color='#D85A30', alpha=0.85)\n",
    "ax2.set_xticks(list(x)); ax2.set_xticklabels(ner_df_reset['entity_type'], fontsize=9)\n",
    "ax2.set_ylim(0, 1.1); ax2.set_title('NER by Entity Type (BERT-NER)')\n",
    "ax2.set_ylabel('Score'); ax2.legend(fontsize=8); ax2.grid(axis='y', alpha=0.3)\n",
    "\n",
    "# ROUGE\n",
    "ax3 = axes[2]\n",
    "metrics3 = ['ROUGE-1', 'ROUGE-2']\n",
    "vals3 = [rouge_df['rouge1'].mean(), rouge_df['rouge2'].mean()]\n",
    "bars3 = ax3.bar(metrics3, vals3, color=['#EF9F27','#D85A30'], alpha=0.85, width=0.4)\n",
    "ax3.set_ylim(0, 1.1); ax3.set_title('Summariser (BART)')\n",
    "ax3.set_ylabel('Score'); ax3.grid(axis='y', alpha=0.3)\n",
    "for bar, v in zip(bars3, vals3):\n",
    "    ax3.text(bar.get_x()+bar.get_width()/2, v+0.01, f'{v:.3f}', ha='center', fontsize=10, fontweight='bold')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('../outputs/baseline_performance.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "print('Baseline benchmark complete ✓')\n",
    "print('These numbers justify CGR routing — no single agent handles all doc types equally well')"
   ]
  }
