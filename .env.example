# LUMINA — Environment Variables
# Copy this to .env and fill in your values

# ── Mistral API ─────────────────────────────────────
MISTRAL_API_KEY=hdd30lQaVEcAv9WWugWTh1nOxoO1a3hH
MISTRAL_MODEL=mistral-large-latest

# ── HuggingFace ──────────────────────────────────────
HF_TOKEN=your_huggingface_token_here

# ── MLflow ───────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=lumina_v1

# ── Application ──────────────────────────────────────
ENV=development
LOG_LEVEL=INFO
PYTHONPATH=src

# ── Model settings ───────────────────────────────────
DEVICE=cpu    # set to 'cuda' if GPU available
USE_LIGHT_VQA_MODEL=true
